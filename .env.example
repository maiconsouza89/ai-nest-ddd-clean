NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# pool e timeouts do Postgres (opcionais; os valores abaixo são os padrões). SSL vai na DATABASE_URL (sslmode)
# conexões no pool de cada processo
# DATABASE_POOL_MAX=10
# espera por uma conexão, em ms, inclusive na fila do pool cheio
# DATABASE_CONNECT_TIMEOUT_MS=5000
# o servidor cancela a query mais longa que isso, em ms (0 = sem limite da app); migrations e seeds não o usam
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# o servidor encerra a sessão com transação ociosa por mais que isso, em ms (0 = sem limite da app)
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# cache de leitura, filas do BullMQ e rate limit; sobe com `docker compose up -d redis`
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-with-at-least-32-random-characters
# servidor SMTP dos e-mails; o Mailpit do compose (`docker compose up -d mailpit`) mostra os e-mails em http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=no-reply@example.com
# validade do access token, em segundos (900 = 15 minutos)
JWT_ACCESS_TTL_SECONDS=900
# validade de cada refresh token (30 dias) e prazo absoluto da sessão desde o login (90 dias)
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_FAMILY_MAX_AGE_SECONDS=7776000
# validade do código de verificação do e-mail, em segundos (600 = 10 minutos)
EMAIL_VERIFICATION_CODE_TTL_SECONDS=600
OUTBOX_WORKER_ENABLED=true
# workers das filas de eventos (BullMQ); desligue nas instâncias que só atendem HTTP
QUEUE_WORKERS_ENABLED=true
CORS_ORIGINS=
# número de proxies confiáveis na frente da API; em produção atrás de proxy NÃO deixe 0
TRUST_PROXY=0
# jobs agendados (ex.: apagar refresh tokens vencidos); só uma instância por vez executa cada job
JOBS_ENABLED=true
# minutos sem alteração até um pedido DRAFT/PLACED ser cancelado
ORDER_EXPIRATION_MINUTES=1440
THROTTLE_ENABLED=true
LOG_LEVEL=info
# atraso do desligamento no SIGTERM, em ms (/health/ready responde 503 nesse tempo); 0 em desenvolvimento
SHUTDOWN_GRACE_MS=0
# tracing (OpenTelemetry): otlp | console | none. `console` despeja cada span no terminal (muito
# barulhento): use `none` no dia a dia e `otlp` com um coletor. Sem spans, os logs saem sem trace_id.
# OTEL_SDK_DISABLED=true desliga a instrumentação por completo
OTEL_TRACES_EXPORTER=none
# métricas: otlp | prometheus | console | none. `none` é o padrão sem coletor; `console` imprime a cada
# 60 s. Métricas e logs saem por OTLP por padrão: sem coletor, `none` (docs/reference/variaveis-de-ambiente.md)
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_SERVICE_NAME=ai-nest-ddd-clean
