NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# cache de leitura (e, na fase 12, filas); sobe com `docker compose up -d redis`
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600
OUTBOX_WORKER_ENABLED=true
# workers das filas de eventos (BullMQ); desligue nas instâncias que só atendem HTTP
QUEUE_WORKERS_ENABLED=true
CORS_ORIGINS=
# número de proxies confiáveis na frente da API; em produção atrás de proxy NÃO deixe 0
TRUST_PROXY=0
# jobs agendados (ex.: expirar pedidos parados); só uma instância por vez executa cada job
JOBS_ENABLED=true
# minutos sem alteração até um pedido DRAFT/PLACED ser cancelado
ORDER_EXPIRATION_MINUTES=1440
THROTTLE_ENABLED=true
LOG_LEVEL=info
# tracing (OpenTelemetry): otlp | console | none. `console` despeja cada span no terminal (muito
# barulhento): use `none` no dia a dia e `otlp` com um coletor. Sem spans, os logs saem sem traceId.
# OTEL_SDK_DISABLED=true desliga a instrumentação por completo
OTEL_TRACES_EXPORTER=none
OTEL_SERVICE_NAME=ddd-clean-nest
