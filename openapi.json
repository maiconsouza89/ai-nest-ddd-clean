  "info": {
    "title": "AI NestJS DDD/Clean",
    "description": "API em NestJS: monólito modular com DDD e Clean Architecture.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateOrderItemRequest": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "qty": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "productId",
          "qty"
        ]
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemRequest"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priceCents": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          }
        },
        "required": [
          "name",
          "priceCents"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ProblemDetailsResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ],
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "description": "Frase do status HTTP.",
            "example": "Unauthorized"
          },
          "status": {
            "type": "number",
            "example": 401
          },
          "detail": {
            "type": "string",
            "description": "Explicação para leitura. O cliente decide pelo `code`, não por este texto.",
            "example": "Invalid email or password"
          },
          "instance": {
            "type": "string",
            "description": "Caminho da requisição, sem a query string.",
            "example": "/v1/auth/login"
          },
          "code": {
            "type": "string",
            "description": "Código de erro: o do erro de domínio, `VALIDATION_FAILED`, `INTERNAL_ERROR` ou o nome do status (`NOT_FOUND`, `TOO_MANY_REQUESTS`).",
            "example": "INVALID_CREDENTIALS"
          },
          "traceId": {
            "type": "string",
            "description": "Id do trace da requisição. Ausente com o tracing desligado.",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "errors": {
            "description": "Só em `VALIDATION_FAILED`: um item por mensagem.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationProblemResponse"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ]
      },
      "ProductOrmEntity": {
        "type": "object",
        "properties": {}
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "ResendVerificationCodeRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          }
        },
        "required": [
          "email"
        ]
      },
      "TerminusHealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error",
              "ok",
              "degraded",
              "shutting_down"
            ],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            },
            "nullable": true
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {},
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            }
          }
        },
        "required": [
          "status",
          "details"
        ]
      },
      "TerminusHealthIndicatorResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "degraded",
              "down"
            ],
            "description": "The status of this health indicator"
          },
          "responseTime": {
            "type": "number",
            "description": "Time the health indicator took to respond, in ms"
          },
          "cachedResponse": {
            "type": "boolean",
            "description": "Whether this result was served from the cache"
          }
        },
        "required": [
          "status"
        ]
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "priceCents": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000
          }
        }
      },
      "ValidationProblemResponse": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer do campo no objeto validado: o corpo, ou a query num DTO de `@Query()`. Ausente no item que avisa que as mensagens passaram do limite.",
            "example": "#/items/0/qty"
          },
          "detail": {
            "type": "string",
            "example": "quantity must not be less than 1"
          }
        },
        "required": [
          "detail"
        ]
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email"
          },
          "code": {
            "type": "string",
            "description": "Os 6 dígitos recebidos por e-mail.",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "email",
          "code"
        ]
      }
    }
  }
}
