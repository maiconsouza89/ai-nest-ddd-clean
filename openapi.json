{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "O processo está vivo"
          },
          "429": {
            "description": "TOO_MANY_REQUESTS: passou do limite de requisições.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          }
        },
        "summary": "O processo está vivo. Não consulta dependências e não passa pelo Terminus, que responderia 503\ndurante o atraso do desligamento: ali só o ready deve falhar.",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "error": {
                      "example": {}
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "TOO_MANY_REQUESTS: passou do limite de requisições.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: erro inesperado.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "error": {
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "O processo pode receber tráfego: o banco e o Redis respondem, e a app não está desligando.\n\nResponde o resultado do Terminus como ele é, inclusive no 503 (dependência fora ou app\ndesligando). O 503 não passa pelo `ProblemDetailsFilter`: a resposta mantém os indicadores, e o\nTerminus já loga a falha.",
        "tags": [
          "health"
        ]
      }
    },
