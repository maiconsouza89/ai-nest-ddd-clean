{
  "name": "ddd-clean-nest",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise src",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run arch",
    "build": "nest build",
    "start:dev": "nest start --watch",
    "test:e2e": "vitest run --project e2e",
    "mig:orders:gen": "typeorm-ts-node-commonjs migration:generate src/modules/orders/infra/database/typeorm/migrations/change -d src/modules/orders/infra/database/typeorm/orders.data-source.ts",
    "mig:orders:run": "typeorm-ts-node-commonjs migration:run -d src/modules/orders/infra/database/typeorm/orders.data-source.ts",
    "test:int": "vitest run --project int",
    "mig:identity:gen": "typeorm-ts-node-commonjs migration:generate src/modules/identity/infra/database/typeorm/migrations/change -d src/modules/identity/infra/database/typeorm/identity.data-source.ts",
    "mig:identity:run": "typeorm-ts-node-commonjs migration:run -d src/modules/identity/infra/database/typeorm/identity.data-source.ts",
    "mig:catalog:gen": "typeorm-ts-node-commonjs migration:generate src/modules/catalog/database/migrations/change -d src/modules/catalog/database/catalog.data-source.ts",
    "mig:catalog:run": "typeorm-ts-node-commonjs migration:run -d src/modules/catalog/database/catalog.data-source.ts",
    "mig:inventory:gen": "typeorm-ts-node-commonjs migration:generate src/modules/inventory/infra/database/typeorm/migrations/change -d src/modules/inventory/infra/database/typeorm/inventory.data-source.ts",
    "mig:inventory:run": "typeorm-ts-node-commonjs migration:run -d src/modules/inventory/infra/database/typeorm/inventory.data-source.ts",
    "mig:outbox:gen": "typeorm-ts-node-commonjs migration:generate src/shared/infra/outbox/migrations/change -d src/shared/infra/outbox/outbox.data-source.ts",
    "mig:outbox:run": "typeorm-ts-node-commonjs migration:run -d src/shared/infra/outbox/outbox.data-source.ts",
    "seed:identity": "ts-node src/modules/identity/infra/database/typeorm/seeds/run.ts",
    "seed:catalog": "ts-node src/modules/catalog/database/seeds/run.ts",
    "seed:inventory": "ts-node src/modules/inventory/infra/database/typeorm/seeds/run.ts",
    "plop": "plop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0"
  },
  "keywords": [],
