    "@testcontainers/redis": "^12.2.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "plop": "^4.0.5",
    "prettier": "3.10.1",
