{
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "dtoFileNameSuffix": [
            ".request.ts",
            ".requests.ts",
            ".query.ts",
            ".response.ts",
            ".responses.ts"
          ]
        }
      }
    ]
  }
}
