// Lint do Markdown (npm run docs:check). Motivos na ADR 0006.
{
  "globs": ["**/*.md"],
  "gitignore": true,
  "config": {
    // Um parágrafo por linha, e tabelas largas. Quebrar linhas não ajuda a leitura nem o diff.
    "MD013": false,
    // Um checklist repete os títulos das seções que resume ("Operação" na seção e no checklist).
    "MD024": { "siblings_only": true },
  },
  "overrides": [
    {
      // Sem título na primeira linha: um CLAUDE.md ou CLAUDE.local.md começa com `@AGENTS.md` (ADR 0007),
      // e o template de PR vira a descrição do PR, que já tem o título como cabeçalho.
      "filter": ["**/CLAUDE.md", "**/CLAUDE.local.md", "**/pull_request_template.md"],
      "config": { "MD041": false },
      "combine": "merge",
    },
  ],
}
